{% extends "base.twig" %}

{% block head %}
  <title>Client Portal | Emonks</title>
{% endblock %}

{% block content %}
<section class="section emonks-saas-section">
<div class="container py-4 py-lg-5 emonks-account-shell">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Client Portal</h1>
      <p class="text-muted mb-0">Overzicht van service-items binnen je account.</p>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Titel</th>
              <th>Status</th>
              <th class="text-end">Actie</th>
            </tr>
          </thead>
          <tbody>
            {% if cp_items is empty %}
              <tr><td colspan="3" class="text-center py-4 text-muted">Nog geen items.</td></tr>
            {% else %}
              {% for item in cp_items %}
                {% set status = function('emonks_normalize_status', function('get_post_meta', item.ID, 'status', true)|default('open'), 'open') %}
                <tr>
                  <td>{{ item.post_title }}</td>
                  <td><span class="badge {{ function('emonks_get_status_badge_class', status) }}">{{ function('emonks_get_status_label', status) }}</span></td>
                  <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="{{ function('emonks_get_client_portal_url', item.ID ~ '/') }}">Open</a>
                  </td>
                </tr>
              {% endfor %}
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</section>
{% endblock %}
