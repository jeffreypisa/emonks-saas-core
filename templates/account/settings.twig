{% extends "base.twig" %}

{% block head %}
  <title>Instellingen | Emonks</title>
{% endblock %}

{% block content %}
<section class="section emonks-saas-section">
<div class="container py-4 py-lg-5">
  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h1 class="h4 mb-3">Account instellingen</h1>
          <p class="text-muted">Deze pagina is voorbereid voor profielinstellingen, notificaties, branding en API preferences vanuit theme-uitbreidingen.</p>
          <div class="alert alert-light border mb-0">Tip: gebruik settings uit de plugin-context en bewaar UI-specifieke velden in je theme of service module.</div>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h2 class="h6">Features</h2>
          <ul class="list-unstyled small mb-0">
            {% for feature, enabled in feature_flags %}
              <li class="mb-2 d-flex justify-content-between"><span>{{ feature }}</span><span class="badge {{ enabled ? 'text-bg-success' : 'text-bg-secondary' }}">{{ enabled ? 'on' : 'off' }}</span></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
</section>
{% endblock %}
