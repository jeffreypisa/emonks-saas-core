{% extends "base.twig" %}

{% block head %}
  <title>Registreren | Emonks</title>
{% endblock %}

{% block content %}
<section class="section emonks-saas-section">
<div class="container py-5 emonks-account-shell">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
          <h1 class="h4 mb-2">Account aanmaken</h1>
          <p class="text-muted mb-4">Start met een generieke workspace en schaal per service type.</p>
          {% if flash_messages %}
            {% for key, message in flash_messages %}
              <div class="alert {{ function('emonks_alert_variant', key) }} alert-dismissible fade show mb-3" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
            {% endfor %}
          {% endif %}
          {% if form_errors %}
            {% for key, message in form_errors %}
              <div class="alert alert-danger mb-3" role="alert">{{ message }}</div>
            {% endfor %}
          {% endif %}
          <form method="post" class="vstack gap-3">
            {{ function('wp_nonce_field', 'emonks_register_action', 'emonks_nonce') }}
            {% set register_form = form|default({}) %}
            {% set register_fields = register_form.fields|default([]) %}
            {% if register_fields is empty %}
              <div>
                <label class="form-label" for="email">E-mailadres</label>
                <input id="email" name="email" type="email" class="form-control" required>
              </div>
              <div>
                <label class="form-label" for="password">Wachtwoord</label>
                <input id="password" name="password" type="password" class="form-control" minlength="8" required>
              </div>
            {% else %}
              {% for field in register_fields %}
                {% set field_key = field.key|default('') %}
                {% set field_type = field.type|default('text') %}
                <div>
                  <label class="form-label" for="{{ field_key }}">{{ field.label|default(field_key|capitalize) }}</label>
                  <input
                    id="{{ field_key }}"
                    name="{{ field_key }}"
                    type="{{ field_type == 'password' ? 'password' : (field_type == 'email' ? 'email' : 'text') }}"
                    class="form-control"
                    value="{{ field_type == 'password' ? '' : (form_values[field_key]|default(field.default|default(''))) }}"
                    placeholder="{{ field.placeholder|default('') }}"
                    {{ field.required ? 'required' : '' }}>
                  {% if field.help %}
                    <div class="form-text">{{ field.help }}</div>
                  {% endif %}
                </div>
              {% endfor %}
            {% endif %}
            <button class="btn btn-primary" type="submit">{{ register_form.submit_label|default('Registreren') }}</button>
          </form>
          <p class="small text-muted mt-3 mb-0">Al een account? <a href="/{{ routes.login }}/">Inloggen</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
</section>
{% endblock %}
