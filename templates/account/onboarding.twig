{% extends "base.twig" %}

{% block head %}
  <title>Onboarding | Emonks</title>
{% endblock %}

{% block content %}
<section class="section emonks-saas-section">
<div class="container py-4 py-lg-5 emonks-account-shell">
  {% if flash_messages %}
    <div class="mb-3">
      {% for key, message in flash_messages %}
        <div class="alert {{ function('emonks_alert_variant', key) }} alert-dismissible fade show mb-2" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
      {% endfor %}
    </div>
  {% endif %}
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <h1 class="h4 mb-2">Onboarding</h1>
      <p class="text-muted mb-3">Doorloop de checklist om je workspace live te zetten.</p>
      <div class="progress" role="progressbar" aria-label="Onboarding progress" aria-valuenow="{{ onboarding_progress.percentage }}" aria-valuemin="0" aria-valuemax="100" style="height:10px;">
        <div class="progress-bar" style="width: {{ onboarding_progress.percentage }}%"></div>
      </div>
      <p class="small text-muted mt-2 mb-0">{{ onboarding_progress.percentage }}% voltooid</p>
    </div>
  </div>

  <div class="row g-3">
    {% for step, done in onboarding_progress.steps %}
      {% set step_url = '/' ~ routes.account ~ '/' %}
      {% set step_cta = 'Open account' %}
      {% if step == 'first_workspace' %}
        {% set step_url = '/' ~ routes.account ~ '/' ~ routes.workspaces ~ '/' %}
        {% set step_cta = 'Ga naar workspaces' %}
      {% elseif step == 'billing_connected' %}
        {% set step_url = '/' ~ routes.account ~ '/' ~ routes.billing ~ '/' %}
        {% set step_cta = 'Ga naar billing' %}
      {% elseif step == 'workspace_published' %}
        {% set step_url = '/' ~ routes.account ~ '/' ~ routes.workspaces ~ '/' %}
        {% set step_cta = 'Publiceer workspace' %}
      {% elseif step == 'account_created' %}
        {% set step_url = '/' ~ routes.account ~ '/' %}
        {% set step_cta = 'Open dashboard' %}
      {% endif %}
      <div class="col-12 col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <h2 class="h6 text-capitalize mb-0 d-flex align-items-center gap-2">
                <span aria-hidden="true">{{ done ? '✓' : '○' }}</span>
                <span>{{ step|replace({'_':' '}) }}</span>
              </h2>
              <span class="badge {{ done ? 'text-bg-success' : 'text-bg-secondary' }}">{{ done ? 'Voltooid' : 'Open' }}</span>
            </div>
            <p class="small text-muted flex-grow-1">Deze stap wordt automatisch voltooid zodra de onderliggende actie gebeurt.</p>
            <div class="mb-3">
              <a class="btn btn-sm btn-primary" href="{{ step_url }}">{{ step_cta }}</a>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
</section>
{% endblock %}
