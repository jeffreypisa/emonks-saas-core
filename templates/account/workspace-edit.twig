{% extends "base.twig" %}

{% block head %}
  <title>Workspace Bewerken | Emonks</title>
{% endblock %}

{% block content %}
<section class="section emonks-saas-section">
<div class="container py-4 py-lg-5 emonks-account-shell">
  {% if flash_messages %}
    <div class="mb-3">
      {% for key, message in flash_messages %}
        <div class="alert {{ function('emonks_alert_variant', key) }} alert-dismissible fade show mb-2" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
      {% endfor %}
    </div>
  {% endif %}
  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h1 class="h4 mb-3">Workspace bewerken</h1>
          <form method="post" action="{{ admin_post.workspace_save }}" class="row g-3">
            {{ function('wp_nonce_field', 'emonks_workspace_save', 'emonks_nonce') }}
            <input type="hidden" name="workspace_id" value="{{ workspace.ID }}">
            <input type="hidden" name="account_id" value="{{ function('emonks_get_workspace_meta', workspace.ID, 'account_id', current_account_id) }}">
            <div class="col-12">
              <label class="form-label" for="ws_title">Naam</label>
              <input id="ws_title" name="title" class="form-control" value="{{ workspace.post_title }}" required>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="ws_service">Service type</label>
              {% set current_service = function('emonks_get_workspace_meta', workspace.ID, 'service_type', 'generic') %}
              <select id="ws_service" name="service_type" class="form-select">
                {% for service_key, service in service_types %}
                  <option value="{{ service_key }}" {{ service_key == current_service ? 'selected' : '' }}>{{ service.labels.singular|default(service_key|capitalize) }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" for="ws_status">Status</label>
              {% set current_status = function('emonks_get_workspace_status', workspace.ID) %}
              <select id="ws_status" name="workspace_status" class="form-select">
                {% for key, label in workspace_statuses %}
                  <option value="{{ key }}" {{ key == current_status ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-12">
              <label class="form-label" for="ws_slug">Public slug</label>
              <input id="ws_slug" name="public_slug" class="form-control" value="{{ function('emonks_get_workspace_meta', workspace.ID, 'public_slug', '') }}">
              <div class="form-text">Bij conflict krijg je direct suggesties voor alternatieve slugs.</div>
            </div>
            <div class="col-12">
              <label class="form-label" for="ws_settings">Settings JSON</label>
              <textarea id="ws_settings" name="settings_json" rows="8" class="form-control">{{ function('emonks_get_workspace_meta', workspace.ID, 'settings', '{}') }}</textarea>
            </div>
            <div class="col-12 d-none" id="service-fields-wrap">
              <hr class="my-2">
              <h3 class="h6 mb-3">Service velden</h3>
              <div id="service-fields-grid" class="row g-3"></div>
            </div>
            <div class="col-12 d-flex gap-2">
              <button class="btn btn-primary" type="submit">Opslaan</button>
              <a class="btn btn-outline-secondary" href="/{{ routes.account }}/{{ routes.workspaces }}/">Terug</a>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h2 class="h6 text-uppercase text-muted">Publicatiehulp</h2>
          <p class="small text-muted mb-0">Public pagina is alleen zichtbaar wanneer status <code>published</code> is en owner een actieve subscription heeft.</p>
        </div>
      </div>
    </div>
  </div>
</div>
</section>
<script>
  (function () {
    var serviceSelect = document.getElementById('ws_service');
    var wrap = document.getElementById('service-fields-wrap');
    var grid = document.getElementById('service-fields-grid');
    var schemas = {{ service_schemas.services|default({})|json_encode|raw }};
    var currentData = {{ workspace_service_data|default({})|json_encode|raw }};
    if (!serviceSelect || !wrap || !grid) { return; }

    function inputType(fieldType) {
      if (fieldType === 'email') { return 'email'; }
      if (fieldType === 'url') { return 'url'; }
      return 'text';
    }

    function renderFields() {
      var serviceKey = serviceSelect.value;
      var schema = schemas[serviceKey] || null;
      var fields = schema && Array.isArray(schema.fields) ? schema.fields : [];
      grid.innerHTML = '';

      if (!fields.length) {
        wrap.classList.add('d-none');
        return;
      }

      fields.forEach(function (field) {
        if (!field || !field.key) { return; }
        var col = document.createElement('div');
        col.className = (field.type === 'textarea') ? 'col-12' : 'col-12 col-md-6';

        var label = document.createElement('label');
        label.className = 'form-label';
        label.setAttribute('for', 'service_data_' + field.key);
        label.textContent = field.label || field.key;
        col.appendChild(label);

        var input;
        if (field.type === 'textarea') {
          input = document.createElement('textarea');
          input.rows = 3;
        } else {
          input = document.createElement('input');
          input.type = inputType(field.type || 'text');
        }
        input.className = 'form-control';
        input.id = 'service_data_' + field.key;
        input.name = 'service_data_' + field.key;
        input.placeholder = field.placeholder || '';
        if (field.required) { input.required = true; }
        input.value = currentData[field.key] || field.default || '';
        col.appendChild(input);

        if (field.help) {
          var help = document.createElement('div');
          help.className = 'form-text';
          help.textContent = field.help;
          col.appendChild(help);
        }

        grid.appendChild(col);
      });

      wrap.classList.remove('d-none');
    }

    serviceSelect.addEventListener('change', renderFields);
    renderFields();
  })();
</script>
{% endblock %}
